  <!-- Interactive JavaScript -->
  <script>
    // Retail Price Audit Dataset (Table 1, Jumbo Romania, March 2026)
    const auditProducts = [
      {
        id: 1,
        category: 'care',
        name: 'Disposable razor (5-pack)',
        note: 'Functionally identical blades & handle',
        mens: 9.99,
        womens: 13.49,
        premium: 35,
        selected: true
      },
      {
        id: 2,
        category: 'care',
        name: 'Antiperspirant deodorant (150ml)',
        note: 'Same active formula, gendered fragrance',
        mens: 11.50,
        womens: 14.99,
        premium: 30,
        selected: true
      },
      {
        id: 3,
        category: 'care',
        name: 'Moisturising body lotion (400ml)',
        note: 'Equivalent volume & base formulation',
        mens: 16.99,
        womens: 22.99,
        premium: 35,
        selected: true
      },
      {
        id: 4,
        category: 'care',
        name: 'Shower gel (500ml)',
        note: 'Same bottle volume, floral vs. neutral packaging',
        mens: 10.49,
        womens: 13.99,
        premium: 33,
        selected: true
      },
      {
        id: 5,
        category: 'toys',
        name: "Children's toy kitchen (plastic, same size)",
        note: 'Sold as grey/yellow "workshop" vs. pink floral kitchen',
        mens: 89.00,
        womens: 98.00,
        premium: 10,
        selected: true
      },
      {
        id: 6,
        category: 'toys',
        name: "Children's science kit (same experiments)",
        note: 'Identical kit contents in pink floral box',
        mens: 34.99,
        womens: 44.99,
        premium: 29,
        selected: true
      },
      {
        id: 7,
        category: 'toys',
        name: "Children's bicycle helmet (same size/safety)",
        note: 'Same safety certification & shell size',
        mens: 49.99,
        womens: 59.99,
        premium: 20,
        selected: true
      }
    ];

    let currentFilter = 'all';

    // Render Retail Audit Table & Visual Bars
    function renderAuditTable() {
      const tbody = document.getElementById('audit-table-body');
      tbody.innerHTML = '';

      const filtered = currentFilter === 'all'
        ? auditProducts
        : auditProducts.filter(p => p.category === currentFilter);

      filtered.forEach(item => {
        const mensWidth = Math.round((item.mens / item.womens) * 100);
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-ivory/70 transition-colors';
        tr.innerHTML = `
          <td class="py-4 px-4 sm:px-6 align-top">
            <input type="checkbox" ${item.selected ? 'checked' : ''} onchange="toggleItem(${item.id})"
              aria-label="Include ${item.name} in basket"
              class="w-4 h-4 mt-1 rounded border-stone-300 text-rose focus:ring-rose cursor-pointer accent-[#C85A6E]" />
          </td>
          <td class="py-4 px-4">
            <div class="font-semibold text-charcoal">${item.name}</div>
            <div class="text-xs text-muted mt-0.5">${item.note}</div>
            <!-- Mini Proportional Price Bar -->
            <div class="mt-2.5 space-y-1 max-w-xs">
              <div class="h-1.5 rounded-full bg-teal" style="width: ${mensWidth}%"></div>
              <div class="h-1.5 rounded-full bg-rose w-full"></div>
            </div>
          </td>
          <td class="py-4 px-4 text-right font-medium text-teal-dark whitespace-nowrap align-top">
            ${item.mens.toFixed(2)} RON
          </td>
          <td class="py-4 px-4 text-right font-semibold text-rose-dark whitespace-nowrap align-top">
            ${item.womens.toFixed(2)} RON
          </td>
          <td class="py-4 px-4 sm:px-6 text-right whitespace-nowrap align-top">
            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-bold bg-rose-light text-rose-dark">
              +${item.premium}%
            </span>
          </td>
        `;
        tbody.appendChild(tr);
      });

      updateCalculator();
    }

    // Toggle individual item in basket
    function toggleItem(id) {
      const product = auditProducts.find(p => p.id === id);
      if (product) {
        product.selected = !product.selected;
        updateCalculator();
      }
    }

    // Select or Deselect all items
    function toggleAllBasket() {
      const anyUnselected = auditProducts.some(p => !p.selected);
      auditProducts.forEach(p => p.selected = anyUnselected);
      renderAuditTable();
    }

    // Filter table by category
    function filterProducts(category) {
      currentFilter = category;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('bg-charcoal', 'text-white');
        btn.classList.add('text-muted');
      });
      const activeBtn = document.getElementById(`filter-${category}`);
      activeBtn.classList.add('bg-charcoal', 'text-white');
      activeBtn.classList.remove('text-muted');

      renderAuditTable();
    }

    // Recalculate Pink Tax totals
    function updateCalculator() {
      const selectedItems = auditProducts.filter(p => p.selected);
      const totalMens = selectedItems.reduce((sum, p) => sum + p.mens, 0);
      const totalWomens = selectedItems.reduce((sum, p) => sum + p.womens, 0);
      const diff = totalWomens - totalMens;
      const pct = totalMens > 0 ? ((diff / totalMens) * 100).toFixed(1) : '0.0';

      document.getElementById('basket-count').textContent = `${selectedItems.length} item${selectedItems.length === 1 ? '' : 's'} selected`;
      document.getElementById('total-mens').textContent = `${totalMens.toFixed(2)} RON`;
      document.getElementById('total-womens').textContent = `${totalWomens.toFixed(2)} RON`;
      document.getElementById('total-diff').textContent = `+${diff.toFixed(2)} RON`;
      document.getElementById('total-percent').textContent = `+${pct}%`;

      const toggleBtn = document.getElementById('toggle-all-btn');
      toggleBtn.textContent = selectedItems.length === auditProducts.length ? 'Clear All' : 'Select All';
    }

    // Theme Tabs Switcher
    function switchTheme(themeNum) {
      document.querySelectorAll('.theme-panel').forEach(panel => panel.classList.add('hidden'));
      document.getElementById(`panel-theme-${themeNum}`).classList.remove('hidden');

      document.querySelectorAll('.theme-tab').forEach(tab => {
        tab.classList.remove('bg-charcoal', 'text-white', 'shadow-sm');
        tab.classList.add('bg-white', 'text-muted', 'border', 'border-stone-200');
      });

      const activeTab = document.getElementById(`tab-theme-${themeNum}`);
      activeTab.classList.add('bg-charcoal', 'text-white', 'shadow-sm');
      activeTab.classList.remove('bg-white', 'text-muted', 'border', 'border-stone-200');
    }

    // Chapter Accordion Toggle
    function toggleChapter(num) {
      const body = document.getElementById(`body-ch-${num}`);
      const icon = document.getElementById(`icon-ch-${num}`);
      const isHidden = body.classList.contains('hidden');

      if (isHidden) {
        body.classList.remove('hidden');
        icon.textContent = '−';
      } else {
        body.classList.add('hidden');
        icon.textContent = '+';
      }
    }

    let allChaptersExpanded = false;
    function toggleAllChapters() {
      allChaptersExpanded = !allChaptersExpanded;
      for (let i = 1; i <= 7; i++) {
        const body = document.getElementById(`body-ch-${i}`);
        const icon = document.getElementById(`icon-ch-${i}`);
        if (allChaptersExpanded) {
          body.classList.remove('hidden');
          icon.textContent = '−';
        } else {
          body.classList.add('hidden');
          icon.textContent = '+';
        }
      }
      document.getElementById('expand-chapters-btn').textContent = allChaptersExpanded ? 'Collapse All Chapters' : 'Expand All Chapters';
    }

    // Initialize on load
    document.addEventListener('DOMContentLoaded', () => {
      renderAuditTable();
    });
  </script>
